{
  "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "palette": [
        { "slug": "background", "name": "Noční pozadí", "color": "#0b1320" },
        { "slug": "surface", "name": "Plocha", "color": "#132238" },
        { "slug": "text", "name": "Text", "color": "#f3f7fb" },
        { "slug": "muted", "name": "Vedlejší text", "color": "#bfd0df" },
        { "slug": "primary", "name": "Jantar", "color": "#f5b942" },
        { "slug": "accent", "name": "Tmavý jantar", "color": "#c7831e" }
      ]
    },
    "layout": {
      "contentSize": "768px",
      "wideSize": "1300px"
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        { "name": "1", "slug": "1", "size": "0.25rem" },
        { "name": "2", "slug": "2", "size": "0.5rem" },
        { "name": "3", "slug": "3", "size": "0.75rem" },
        { "name": "4", "slug": "4", "size": "1rem" },
        { "name": "6", "slug": "6", "size": "1.5rem" },
        { "name": "8", "slug": "8", "size": "2rem" },
        { "name": "12", "slug": "12", "size": "3rem" },
        { "name": "16", "slug": "16", "size": "4rem" }
      ]
    },
    "border": {
      "radius": true
    },
    "shadow": {
      "presets": [
        { "name": "Měkký", "slug": "soft", "shadow": "0 1.25rem 3rem rgb(0 0 0 / 0.25)" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontSizes": [
        { "name": "Malý", "slug": "sm", "size": "0.875rem" },
        { "name": "Základní", "slug": "base", "size": "1rem" },
        { "name": "Střední", "slug": "lg", "size": "1.25rem" },
        { "name": "Nadpis", "slug": "xl", "size": "clamp(1.75rem, 4vw, 3rem)" },
        { "name": "Hero", "slug": "hero", "size": "clamp(2.5rem, 7vw, 5.5rem)" }
      ],
      "fontFamilies": [
        {
          "fontFamily": "Bariol, 'Segoe UI', sans-serif",
          "name": "Bariol",
          "slug": "body",
          "fontFace": [
            {
              "fontFamily": "Bariol",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": ["file:./fonts/bariol_regular-webfont.woff2"]
            },
            {
              "fontFamily": "Bariol",
              "fontStyle": "italic",
              "fontWeight": "400",
              "src": ["file:./fonts/bariol_regular_italic-webfont.woff2"]
            }
          ]
        }
      ]
    },
    "custom": {
      "radius": "0.75rem",
      "content-width": "72rem",
      "wide-width": "86rem"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|background",
      "text": "var:preset|color|text"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body"
    }
  }
}
