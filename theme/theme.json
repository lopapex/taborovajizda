{
  "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "palette": [
        {
          "slug": "background",
          "name": "Papír",
          "color": "#f6efe2"
        },
        {
          "slug": "surface",
          "name": "Světlá plocha",
          "color": "#fffdf8"
        },
        {
          "slug": "text",
          "name": "Text (večerní modř)",
          "color": "#14263a"
        },
        {
          "slug": "muted",
          "name": "Vedlejší text",
          "color": "#4a5c6e"
        },
        {
          "slug": "primary",
          "name": "Slunce",
          "color": "#ffb703"
        },
        {
          "slug": "accent",
          "name": "Oheň",
          "color": "#e4572e"
        },
        {
          "slug": "secondary",
          "name": "Nebe",
          "color": "#219ebc"
        },
        {
          "slug": "link",
          "name": "Odkaz",
          "color": "#a13a12"
        }
      ]
    },
    "layout": {
      "contentSize": "768px",
      "wideSize": "1300px"
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "name": "1",
          "slug": "1",
          "size": "0.25rem"
        },
        {
          "name": "2",
          "slug": "2",
          "size": "0.5rem"
        },
        {
          "name": "3",
          "slug": "3",
          "size": "0.75rem"
        },
        {
          "name": "4",
          "slug": "4",
          "size": "1rem"
        },
        {
          "name": "6",
          "slug": "6",
          "size": "1.5rem"
        },
        {
          "name": "8",
          "slug": "8",
          "size": "2rem"
        },
        {
          "name": "12",
          "slug": "12",
          "size": "3rem"
        },
        {
          "name": "16",
          "slug": "16",
          "size": "4rem"
        }
      ]
    },
    "border": {
      "radius": true
    },
    "shadow": {
      "presets": [
        {
          "name": "Měkký",
          "slug": "soft",
          "shadow": "0 1.25rem 3rem rgb(0 0 0 / 0.25)"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontSizes": [
        {
          "name": "Malý",
          "slug": "sm",
          "size": "0.875rem"
        },
        {
          "name": "Základní",
          "slug": "base",
          "size": "1rem"
        },
        {
          "name": "Střední",
          "slug": "lg",
          "size": "1.25rem"
        },
        {
          "name": "Nadpis",
          "slug": "xl",
          "size": "clamp(1.75rem, 4vw, 3rem)"
        },
        {
          "name": "Hero",
          "slug": "hero",
          "size": "clamp(2.5rem, 7vw, 5.5rem)"
        }
      ],
      "fontFamilies": [
        {
          "fontFamily": "Figtree, 'Segoe UI', system-ui, sans-serif",
          "name": "Figtree",
          "slug": "body"
        },
        {
          "fontFamily": "'Bricolage Grotesque', Figtree, 'Segoe UI', system-ui, sans-serif",
          "name": "Bricolage Grotesque",
          "slug": "heading"
        }
      ]
    },
    "custom": {
      "radius": "1rem",
      "content-width": "68rem",
      "wide-width": "76rem"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|background",
      "text": "var:preset|color|text"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body"
    }
  }
}
